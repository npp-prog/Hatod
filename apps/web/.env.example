# Web app configuration. Copy to .env.local for a real Firebase project, or set
# these in apphosting.yaml / the App Hosting console. All NEXT_PUBLIC_* values
# end up in the browser, so never put secrets here.

# true = connect to the local emulators (auth 9099, firestore 8080, functions 5001, storage 9199)
NEXT_PUBLIC_USE_EMULATORS=false
# Firebase console > Project settings > Your apps > Web app config
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Region the Cloud Functions are deployed to
NEXT_PUBLIC_FUNCTIONS_REGION=asia-southeast1
