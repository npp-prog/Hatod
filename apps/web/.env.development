# Local development against the Firebase Emulator Suite (project demo-hatod).
# These are not secrets: demo-* projects never touch real Firebase.
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-hatod
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-hatod.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-hatod.appspot.com
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app
NEXT_PUBLIC_FUNCTIONS_REGION=asia-southeast1
