rules_version = '2';

// Hatod Firestore rules.
// Principle: clients read what their role needs; anything that changes money,
// status, verification, roles or aggregates is written only by Cloud Functions
// (the Admin SDK bypasses these rules). Default is deny.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function roles() { return signedIn() && request.auth.token.roles is list ? request.auth.token.roles : []; }
    function hasRole(r) { return r in roles(); }
    function isAdmin() { return hasRole('admin'); }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function coordTowns() {
      return hasRole('coordinator') && request.auth.token.coordTowns is list ? request.auth.token.coordTowns : [];
    }
    function isCoordinatorOf(townId) { return townId in coordTowns(); }

    function isPhLatLng(p) {
      return p is map && p.keys().hasOnly(['lat', 'lng']) && p.keys().hasAll(['lat', 'lng'])
        && p.lat is number && p.lng is number
        && p.lat >= 4.2 && p.lat <= 21.5 && p.lng >= 116.0 && p.lng <= 127.0;
    }
    function trimmedLen(s, min, max) { return s is string && s.trim().size() >= min && s.size() <= max; }

    // users/{uid}: profile, roles and status. Roles, status and consent are
    // changed by Cloud Functions only. A user may change their own town and
    // language preference.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['defaultTownId', 'locale', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.defaultTownId == null
            || (request.resource.data.defaultTownId is string
                && exists(/databases/$(database)/documents/towns/$(request.resource.data.defaultTownId))))
        && request.resource.data.locale in ['en', 'fil'];
      allow create, delete: if false;
    }

    // Admin audit trail.
    match /adminLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // towns: live towns are public (town picker); admins and that town's
    // coordinators also see towns that are not live yet. Written by admin functions.
    match /towns/{townId} {
      allow read: if resource.data.isLive == true || resource.data.acceptingSignups == true || isAdmin() || isCoordinatorOf(townId);
      allow write: if false;
    }

    // barangays: public names and centroids. Written by admin functions.
    match /barangays/{id} {
      allow read: if true;
      allow write: if false;
    }

    // addresses: a customer's own saved addresses, written directly by the
    // client so they work offline. The barangay must belong to the address town.
    match /addresses/{id} {
      function barangayMatches(d) {
        let b = get(/databases/$(database)/documents/barangays/$(d.barangayId)).data;
        return b.townId == d.townId && b.name == d.barangayName;
      }
      function validAddress(d) {
        return d.keys().hasOnly(['userId', 'townId', 'label', 'barangayId', 'barangayName', 'street', 'landmark', 'geo', 'isDefault', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['userId', 'townId', 'label', 'barangayId', 'barangayName', 'street', 'landmark', 'geo', 'isDefault', 'createdAt', 'updatedAt'])
          && trimmedLen(d.label, 1, 30)
          && d.street is string && d.street.size() <= 120
          && trimmedLen(d.landmark, 3, 200)
          && isPhLatLng(d.geo)
          && d.isDefault is bool
          && d.townId is string
          && d.barangayId is string
          && barangayMatches(d)
          && d.updatedAt == request.time;
      }

      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validAddress(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && validAddress(request.resource.data);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // Shop images live in Storage under shops/{shopId}/public/. URLs written by
    // clients must point there, so a listing cannot show images from elsewhere.
    function isShopImageUrl(url, shopId) {
      return url is string && url.size() < 1000
        && url.matches('^https?://[^ ]+/o/shops%2F' + shopId + '%2Fpublic%2F[^ ]+$');
    }
    function nullOrShopImage(url, shopId) { return url == null || isShopImageUrl(url, shopId); }

    // shops: public once verified and active. The owner edits listing, menu and
    // hours fields (exactly those below); verification, status, plan and
    // ratings are written by Cloud Functions only.
    match /shops/{shopId} {
      function isOwner() { return signedIn() && resource.data.ownerId == request.auth.uid; }
      function isListed() { return resource.data.verified == true && resource.data.status == 'active'; }

      function validShop(d) {
        return trimmedLen(d.name, 2, 60)
          && d.category in ['meals', 'snacks', 'drinks', 'bakery', 'groceries']
          && d.description is string && d.description.size() <= 300
          && d.contactPhone is string && d.contactPhone.matches('^\\+639[0-9]{9}$')
          && d.photos is list && d.photos.size() <= 3
          && (d.photos.size() < 1 || isShopImageUrl(d.photos[0], shopId))
          && (d.photos.size() < 2 || isShopImageUrl(d.photos[1], shopId))
          && (d.photos.size() < 3 || isShopImageUrl(d.photos[2], shopId))
          && d.street is string && d.street.size() <= 120
          && trimmedLen(d.landmark, 3, 200)
          && isPhLatLng(d.geo)
          && get(/databases/$(database)/documents/barangays/$(d.barangayId)).data.townId == d.townId
          && get(/databases/$(database)/documents/barangays/$(d.barangayId)).data.name == d.barangayName
          && d.hours is map && d.hours.keys().hasOnly(['mon', 'tue', 'wed', 'thu', 'fri', 'sat', 'sun'])
          && (d.closedOn == null || (d.closedOn is string && d.closedOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && d.prepMinutes is int && d.prepMinutes >= 0 && d.prepMinutes <= 180
          && d.busyMinutes is int && d.busyMinutes >= 0 && d.busyMinutes <= 120
          && d.paymentMethods is list && d.paymentMethods.size() >= 1
          && d.paymentMethods.hasOnly(['cash', 'gcash', 'maya'])
          && nullOrShopImage(d.gcashQrUrl, shopId)
          && nullOrShopImage(d.mayaQrUrl, shopId)
          && d.hasOwnRider is bool
          && d.selfDeliveryFee is int && d.selfDeliveryFee >= 0 && d.selfDeliveryFee <= 1000
          && d.menuCategories is list && d.menuCategories.size() <= 20
          && d.updatedAt == request.time;
      }

      allow read: if isListed() || isOwner() || isAdmin() || isCoordinatorOf(resource.data.townId);
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'category', 'description', 'contactPhone', 'photos', 'barangayId', 'barangayName',
          'street', 'landmark', 'geo', 'hours', 'closedOn', 'prepMinutes', 'busyMinutes',
          'paymentMethods', 'gcashQrUrl', 'mayaQrUrl', 'hasOwnRider', 'selfDeliveryFee',
          'menuCategories', 'updatedAt'])
        && validShop(request.resource.data);
      allow create, delete: if false;

      function shopData() { return get(/databases/$(database)/documents/shops/$(shopId)).data; }
      function ownsShop() { return signedIn() && shopData().ownerId == request.auth.uid; }
      function staffView() { return ownsShop() || isAdmin() || isCoordinatorOf(shopData().townId); }

      // Owner name, owner phone and the business permit: not public.
      match /private/{docId} {
        allow read: if signedIn() && staffView();
        allow update: if ownsShop()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permitPath', 'updatedAt'])
          && (request.resource.data.permitPath == null
              || (request.resource.data.permitPath is string
                  && request.resource.data.permitPath.matches('^private/towns/' + shopData().townId + '/shops/' + shopId + '/[^/]+$')))
          && request.resource.data.updatedAt == request.time;
        allow create, delete: if false;
      }

      // Menu: public with the shop; the owner manages it.
      match /menuItems/{itemId} {
        function validItem(d) {
          return d.keys().hasOnly(['name', 'description', 'category', 'price', 'photoUrl', 'variants', 'addOns', 'available', 'sortOrder', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['name', 'description', 'category', 'price', 'photoUrl', 'variants', 'addOns', 'available', 'sortOrder', 'createdAt', 'updatedAt'])
            && trimmedLen(d.name, 1, 60)
            && d.description is string && d.description.size() <= 200
            && trimmedLen(d.category, 1, 40)
            && d.price is int && d.price >= 0 && d.price <= 100000
            && nullOrShopImage(d.photoUrl, shopId)
            && d.variants is list && d.variants.size() <= 10
            && d.addOns is list && d.addOns.size() <= 20
            && d.available is bool
            && d.sortOrder is number
            && d.updatedAt == request.time;
        }
        allow read: if (shopData().verified == true && shopData().status == 'active') || staffView();
        allow create: if ownsShop() && validItem(request.resource.data) && request.resource.data.createdAt == request.time;
        allow update: if ownsShop()
          && request.resource.data.createdAt == resource.data.createdAt
          && validItem(request.resource.data);
        allow delete: if ownsShop();
      }
    }

    // riders/{uid}: the doc id is the rider's user id. Public once verified and
    // active (customers choose riders by name, photo, vehicle, plate, rating
    // and rate card). The rider edits their photo, switches and, until
    // verified, their vehicle; rate card and service area go through Cloud
    // Functions (validation and the 24-hour limit); verification, status,
    // plan and ratings are written by functions only.
    match /riders/{uid} {
      function isRider() { return signedIn() && request.auth.uid == uid; }
      function isListed() { return resource.data.verified == true && resource.data.status == 'active'; }
      function d() { return request.resource.data; }
      function changed() { return d().diff(resource.data).affectedKeys(); }

      allow read: if isListed() || isRider() || isAdmin() || isCoordinatorOf(resource.data.townId);
      allow update: if isRider()
        && changed().hasOnly(['photoUrl', 'vehicleType', 'vehicleDesc', 'plateNo', 'online', 'rainOn', 'lastActiveAt', 'approxLocation', 'updatedAt'])
        && d().updatedAt == request.time
        // vehicle and plate are what the coordinator checked: locked after verification
        && (!changed().hasAny(['vehicleType', 'vehicleDesc', 'plateNo']) || resource.data.verified == false)
        && d().vehicleType in ['motorcycle', 'bicycle', 'tricycle']
        && trimmedLen(d().vehicleDesc, 2, 60)
        && d().plateNo is string && d().plateNo.size() <= 16
        && (d().photoUrl == null || (d().photoUrl is string && d().photoUrl.size() < 1000
            && d().photoUrl.matches('^https?://[^ ]+/o/riders%2F' + uid + '%2Fpublic%2F[^ ]+$')))
        && d().rainOn is bool
        && d().online is bool
        // only a verified, active rider can go online
        && (d().online == false || (resource.data.verified == true && resource.data.status == 'active'))
        && (!changed().hasAny(['online', 'lastActiveAt']) || d().lastActiveAt == request.time)
        // approximate location: only while online, rounded to 2 decimals (about 1 km) for privacy
        && (!('approxLocation' in d()) || d().approxLocation == null
            || (d().online == true && isPhLatLng(d().approxLocation)
                && math.abs(d().approxLocation.lat * 100 - math.round(d().approxLocation.lat * 100)) < 0.000001
                && math.abs(d().approxLocation.lng * 100 - math.round(d().approxLocation.lng * 100)) < 0.000001));
      allow create, delete: if false;

      function riderData() { return get(/databases/$(database)/documents/riders/$(uid)).data; }

      // Legal name, phone, emergency contact and document paths.
      match /private/{docId} {
        function docPathOk(p) {
          return p == null || (p is string && p.matches('^private/towns/' + riderData().townId + '/riders/' + uid + '/[^/]+$'));
        }
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || isCoordinatorOf(riderData().townId));
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['docs', 'emergencyContact', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.docs is map
          && request.resource.data.docs.keys().hasOnly(['governmentId', 'license', 'orcr', 'clearance'])
          && request.resource.data.docs.keys().hasAll(['governmentId', 'license', 'orcr', 'clearance'])
          && docPathOk(request.resource.data.docs.governmentId)
          && docPathOk(request.resource.data.docs.license)
          && docPathOk(request.resource.data.docs.orcr)
          && docPathOk(request.resource.data.docs.clearance)
          && request.resource.data.emergencyContact is map
          && request.resource.data.emergencyContact.keys().hasOnly(['name', 'phone', 'relation'])
          && trimmedLen(request.resource.data.emergencyContact.name, 2, 60)
          && request.resource.data.emergencyContact.phone is string
          && request.resource.data.emergencyContact.phone.matches('^\\+639[0-9]{9}$')
          && trimmedLen(request.resource.data.emergencyContact.relation, 2, 30);
        allow create, delete: if false;
      }
    }

    // orders: written only by Cloud Functions. Readable by the people on the
    // order (customer, shop owner, assigned rider), that town's coordinators
    // and admins. Phone numbers on the order are therefore visible only to the
    // parties of that order.
    match /orders/{orderId} {
      // Queries are checked against their filters, so each kind of list has its
      // own clause: customerId == me, riderId == me, shopId in my shops.
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid
        || resource.data.riderId == request.auth.uid
        || request.auth.uid in resource.data.participants
        || resource.data.shopId in (request.auth.token.shops is list ? request.auth.token.shops : [])
        || isAdmin()
        || isCoordinatorOf(resource.data.townId));
      allow write: if false;
    }

    // Job offers: only the rider they are for (no customer phone in them).
    match /riderOffers/{offerId} {
      allow read: if signedIn() && (resource.data.riderId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // ratings: written by Cloud Functions. The rater, the rated shop or rider,
    // that town's coordinators and admins can read them. Ratings of customers
    // are for staff only (the customer sees just their average).
    match /ratings/{id} {
      allow read: if signedIn() && (
        resource.data.fromUserId == request.auth.uid
        || (resource.data.toType == 'shop' && resource.data.toId in (request.auth.token.shops is list ? request.auth.token.shops : []))
        || (resource.data.toType == 'rider' && resource.data.toId == request.auth.uid)
        || isAdmin()
        || isCoordinatorOf(resource.data.townId));
      allow write: if false;
    }

    // reports: written by Cloud Functions. The reporter, that town's
    // coordinators and admins can read them. The reported person cannot.
    match /reports/{id} {
      allow read: if signedIn() && (resource.data.reporterId == request.auth.uid || isAdmin() || isCoordinatorOf(resource.data.townId));
      allow write: if false;
    }

    // Web push tokens a person registered on their own devices.
    match /users/{uid}/devices/{token} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
        && request.resource.data.token == token
        && request.resource.data.token.size() < 400
        && request.resource.data.platform is string && request.resource.data.platform.size() < 40
        && request.resource.data.updatedAt == request.time;
    }

    // Everything else is closed until its milestone adds a rule.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
