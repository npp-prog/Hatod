# Copy to .env.<projectId> (e.g. .env.hatod-prod) for each real Firebase project.
# Phone numbers that get the admin role on their first sign-in. Use this once to
# create the first admin, then manage roles from the admin area.
ADMIN_PHONES=

# Providers: console/mock for development, real ones in production.
SMS_PROVIDER=semaphore
SEMAPHORE_SENDER=HATOD
PAYMENT_PROVIDER=paymongo
# Where PayMongo sends people back after paying
APP_BASE_URL=https://example.com
